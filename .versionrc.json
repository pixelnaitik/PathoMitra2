{
  "$schema": "https://json.schemastore.org/standard-versionrc.json",
  "header": "# Changelog\n\nAll notable changes to this project are documented in this file and are generated automatically from [Conventional Commits](https://www.conventionalcommits.org/) by `npm run release`.\n",
  "tagPrefix": "v",
  "types": [
    { "type": "feat", "section": "✨ Features" },
    { "type": "perf", "section": "⚡ Performance" },
    { "type": "fix", "section": "🐛 Bug Fixes" },
    { "type": "refactor", "section": "♻️ Refactors", "hidden": false },
    { "type": "revert", "section": "⏪ Reverts" },
    { "type": "docs", "section": "📝 Documentation", "hidden": true },
    { "type": "style", "section": "🎨 Styles", "hidden": true },
    { "type": "test", "section": "✅ Tests", "hidden": true },
    { "type": "build", "section": "📦 Build System", "hidden": true },
    { "type": "ci", "section": "👷 CI", "hidden": true },
    { "type": "chore", "section": "🔧 Chores", "hidden": true }
  ]
}

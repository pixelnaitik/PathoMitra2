# ---------------------------------------------------------------------------
# PathLab OS environment configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# The app is local-first: there is no Firebase client config, no signing secret
# and no backend URL to configure. Everything here is either a release-identity
# value Google Play requires, or a local development switch.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Release identity — REQUIRED before a Google Play submission
# ---------------------------------------------------------------------------
# Both are baked into the shipped bundle and printed in the privacy policy, and
# `npm run build:android` fails without them (scripts/check-release-config.mjs).
# A comment in the source used to be the only reminder, and a comment survives a
# build while a bad contact survives review.

# Public privacy/support contact. Must be monitored and on a domain you own.
# Play rejects an app handling health data whose contact is unreachable.
VITE_SUPPORT_EMAIL="privacy@your-lab-domain.example"

# Canonical URL of the published privacy policy — the link in the Play listing.
# Generate the page with `npm run build:privacy`, then host `privacy-site/` here.
# A shared platform subdomain (pages.dev / vercel.app / github.io) is rejected by
# the guard: it is not a location you control.
VITE_PRIVACY_URL="https://policy.your-lab-domain.example/"

# ---------------------------------------------------------------------------
# Android release signing — read by Gradle, not Vite
# ---------------------------------------------------------------------------
# Normally supplied via `android/keystore.properties` (git-ignored). These
# environment names are the CI alternative; see build.gradle.
# KEYSTORE_FILE
# KEYSTORE_KEY_ALIAS
# KEYSTORE_KEY_PASSWORD
# KEYSTORE_STORE_PASSWORD

# ---------------------------------------------------------------------------
# Build / dev switches (all optional)
# ---------------------------------------------------------------------------
# VITE_TARGET=native       Set automatically by `npm run build:android`; strips
#                          the web-deploy assets (robots.txt, sitemap, sw.js,
#                          _headers, _redirects) so they never enter the APK.
# SOURCEMAP=true           Emit hidden .map files for stack-trace symbolication.
#                          Delete them from dist/ before deploying anything public.
# DISABLE_HMR=true         Turn off Vite hot module replacement.
# HOST=127.0.0.1           Bind the dev server to localhost only.

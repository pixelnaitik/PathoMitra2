+    /**
+     * Default print attributes for our report documents.
+     *
+     * <p>The print sheet used to be launched with an empty {@link PrintAttributes.Builder}, which
+     * leaves the media size unset. Android then falls back to "Adaptive" orientation and, for the
+     * built-in PDF handler, defaults the sheet to LANDSCAPE — so a portrait A4 report page ends up
+     * letter-boxed onto a wide sheet. Pinning ISO A4 (whose natural orientation is portrait) makes
+     * the dialog open in portrait and keeps the preview faithful to the generated PDF.
+     */
+    private PrintAttributes portraitDocumentAttributes() {
+        return new PrintAttributes.Builder()
+            .setMediaSize(PrintAttributes.MediaSize.ISO_A4)
+            .setResolution(new PrintAttributes.Resolution("default", "default", 300, 300))
+            .setMinMargins(PrintAttributes.Margins.NO_MARGINS)
+            .build();
+    }

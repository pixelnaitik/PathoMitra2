# Release signing credentials for the Android build.
#
# Copy this file to `keystore.properties` in the same directory and fill in real
# values. `keystore.properties` is git-ignored — it must never be committed, and
# neither should the .jks/.keystore it points at (both are ignored in
# android/.gitignore).
#
# `storeFile` may be absolute or relative to the `android/` project root.
# On CI, supply the same four values as KEYSTORE_FILE / KEYSTORE_KEY_ALIAS /
# KEYSTORE_KEY_PASSWORD / KEYSTORE_STORE_PASSWORD repository secrets instead of
# shipping this file.
#
# Generate a keystore once with:
#   keytool -genkeypair -v -storetype PKCS12 -keystore upload-keystore.jks \
#     -alias upload -keyalg RSA -keysize 2048 -validity 10000
storeFile=upload-keystore.jks
storePassword=change-me
keyAlias=upload
keyPassword=change-me

<?xml version='1.0' encoding='utf-8'?>
<resources>
    <!-- Kept byte-identical to `appName` in capacitor.config.ts. This is what the
         launcher, Recents and the system print / share sheets display, so a
         stale value here makes the app introduce itself under two names. -->
    <string name="app_name">PathoMitra</string>
    <string name="title_activity_main">PathoMitra</string>
    <string name="package_name">com.pathomitra.app</string>
    <string name="custom_url_scheme">com.pathomitra.app</string>
</resources>
